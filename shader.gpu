// Vertex shader
const vertexShaderSource = `
attribute vec3 a_position;
attribute vec3 a_normal;
attribute vec2 a_texcoord;
attribute vec3 a_tangent;
attribute vec3 a_bitangent;

uniform mat4 u_projectionMatrix;
uniform mat4 u_modelViewMatrix;
uniform mat4 u_normalMatrix;
uniform vec3 u_lightPosition;
uniform vec4 u_wireframeColor;
uniform mediump int u_renderMode; 

uniform vec3 u_meshAngles; 
uniform vec2 u_meshCenterPoint;

uniform float u_texRotationAngle;
uniform vec2 u_texCenterPoint;

varying vec3 v_color;
varying vec2 v_texcoord;
varying mat3 v_TBN;
varying vec3 v_fragPos;

mat3 rotX(float angle) {
    float s = sin(angle);
    float c = cos(angle);
    return mat3(
        1.0, 0.0, 0.0,
        0.0, c,  -s,
        0.0, s,   c
    );
}

mat3 rotY(float angle) {
    float s = sin(angle);
    float c = cos(angle);
    return mat3(
        c,   0.0, s,
        0.0, 1.0, 0.0,
        -s,  0.0, c
    );
}

mat3 rotZ(float angle) {
    float s = sin(angle);
    float c = cos(angle);
    return mat3(
        c,  -s,  0.0,
        s,   c,  0.0,
        0.0, 0.0, 1.0
    );
}

vec2 rotate2D(vec2 v, float angle) {
    float s = sin(angle);
    float c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}

void main() {
    vec3 pos = a_position;
    vec3 norm = a_normal;
    vec3 tang = a_tangent;
    vec3 bitang = a_bitangent;

    mat3 meshRotMat = rotZ(u_meshAngles.z) * rotY(u_meshAngles.y) * rotX(u_meshAngles.x);

    pos.xy -= u_meshCenterPoint;
    
    pos = meshRotMat * pos;
    
    pos.xy += u_meshCenterPoint;

    norm = meshRotMat * norm;
    tang = meshRotMat * tang;
    bitang = meshRotMat * bitang;

    vec4 viewPos4 = u_modelViewMatrix * vec4(pos, 1.0);
    v_fragPos = viewPos4.xyz;
    gl_Position = u_projectionMatrix * viewPos4;

    vec2 tex = a_texcoord;
    tex -= u_texCenterPoint;
    tex = rotate2D(tex, u_texRotationAngle);
    tex += u_texCenterPoint;
    v_texcoord = tex;

    mat3 normalMat = mat3(u_normalMatrix);
    vec3 T = normalize(normalMat * tang);
    vec3 B = normalize(normalMat * bitang);
    vec3 N = normalize(normalMat * norm);
    v_TBN = mat3(T, B, N);

    if (u_renderMode == 1 || u_renderMode == 2) {
        v_color = u_wireframeColor.rgb;
    } else {
        v_color = vec3(0.0);
    }
}
`;

// Fragment shader
const fragmentShaderSource = `
precision mediump float;

varying vec3 v_color;
varying vec2 v_texcoord;
varying mat3 v_TBN;
varying vec3 v_fragPos;

uniform sampler2D u_diffuseTex;
uniform sampler2D u_specularTex;
uniform sampler2D u_normalTex;
uniform highp vec3 u_lightPosition;

uniform bool u_useDiffuse;
uniform bool u_useSpecular;
uniform bool u_useNormal;
uniform mediump int u_renderMode;

void main() {
    if (u_renderMode == 2 || u_renderMode == 1) {
        gl_FragColor = vec4(v_color, 1.0);
        return; 
    }

    vec3 diffColor = u_useDiffuse ? texture2D(u_diffuseTex, v_texcoord).rgb : vec3(1.0);
    vec3 specColor = u_useSpecular ? texture2D(u_specularTex, v_texcoord).rgb : vec3(1.0);
    vec3 normalMap = u_useNormal ? texture2D(u_normalTex, v_texcoord).rgb * 2.0 - 1.0 : vec3(0.0, 0.0, 1.0);

    vec3 N = normalize(v_TBN * normalMap);
    vec3 L = normalize(u_lightPosition - v_fragPos);
    vec3 V = normalize(-v_fragPos);
    vec3 R = reflect(-L, N);

    vec3 ambient = 0.1 * diffColor;
    vec3 diffuse = diffColor * max(dot(N, L), 0.0);
    vec3 specular = specColor * pow(max(dot(R, V), 0.0), 32.0);

    gl_FragColor = vec4(ambient + diffuse + specular, 1.0);
}
`;